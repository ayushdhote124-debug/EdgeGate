# Copy this file to .env and adjust if needed:
#   Windows cmd:        copy .env.example .env
#   Windows PowerShell: Copy-Item .env.example .env

NODE_ENV=development
LOG_LEVEL=info

# ---- MongoDB ----
# Local (Docker, infra/docker-compose.yml):
MONGO_URL=mongodb://127.0.0.1:27017/edgegate
# MongoDB Atlas: paste your connection string and put the database name /edgegate before the "?".
# URL-encode special characters in the password (@ -> %40, # -> %23, : -> %3A).
# MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/edgegate?retryWrites=true&w=majority

# ---- Redis ----
# Local (Docker, or redis-server inside WSL on Windows):
REDIS_URL=redis://127.0.0.1:6379

# Ports
GATEWAY_PORT=8080
ADMIN_API_PORT=4000
DASHBOARD_PORT=3000

# First admin user, created by `npm run seed`
ADMIN_EMAIL=admin@edgegate.local
ADMIN_PASSWORD=change-me-please

# Used from Phase 5 (Admin API login). Use a long random string.
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars